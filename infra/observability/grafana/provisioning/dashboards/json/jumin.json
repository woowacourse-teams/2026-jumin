{
  "uid": "jumin-overview",
  "title": "Jumin dev / prod",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [{"name": "environment", "type": "custom", "query": "dev,prod", "current": {"text": "prod", "value": "prod"}, "options": [{"text": "dev", "value": "dev"}, {"text": "prod", "value": "prod"}]}]
  },
  "panels": [
    {"id": 1, "title": "Requests / second", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "jumin-prometheus"}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{environment=\"$environment\",uri!~\"/actuator/.*\"}[5m]))", "legendFormat": "requests/s"}]},
    {"id": 2, "title": "Backend 5xx / second", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "jumin-prometheus"}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{environment=\"$environment\",status=~\"5..\"}[5m]))", "legendFormat": "5xx/s"}]},
    {"id": 3, "title": "Backend p95 latency (seconds)", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "jumin-prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{environment=\"$environment\",uri!~\"/actuator/.*\"}[5m])))", "legendFormat": "p95"}]},
    {"id": 4, "title": "Backend scrape up", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "jumin-prometheus"}, "targets": [{"expr": "up{environment=\"$environment\",job=\"backend\"}", "legendFormat": "up"}]},
    {"id": 5, "title": "Host CPU (%)", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "jumin-prometheus"}, "targets": [{"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{environment=\"$environment\",mode=\"idle\"}[5m])))", "legendFormat": "CPU"}]},
    {"id": 6, "title": "Host memory (%)", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "jumin-prometheus"}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{environment=\"$environment\"} / node_memory_MemTotal_bytes{environment=\"$environment\"})", "legendFormat": "memory"}]},
    {"id": 7, "title": "Backend and Nginx logs", "type": "logs", "gridPos": {"x": 0, "y": 24, "w": 24, "h": 10}, "datasource": {"type": "loki", "uid": "jumin-loki"}, "targets": [{"expr": "{environment=\"$environment\",service=~\"backend|nginx\"}"}]}
  ]
}
